<%@ page pageEncoding="UTF-8" %>
<%-- Cabecera común del Dispositivo Móvil: <head> y barra de navegación (Figura 3(a)).
     Se incluye estático; la página que la incluye declara los taglibs c y fn y el atributo "tituloPagina". --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>edEXT Móvil<c:if test="${not empty tituloPagina}"> - <c:out value="${tituloPagina}"/></c:if></title>
    <link rel="icon" type="image/svg+xml" href="${ctx}/movil/static/img/logo-edext.svg?v=${applicationScope.versionRecursosMovil}">
    <link rel="stylesheet" href="${ctx}/movil/static/css/bootstrap.min.css?v=${applicationScope.versionRecursosMovil}">
    <link rel="stylesheet" href="${ctx}/movil/static/css/movil.css?v=${applicationScope.versionRecursosMovil}">
</head>
<body class="movil">
<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top movil-navbar">
    <div class="container">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuMovil"
                aria-controls="menuMovil" aria-expanded="false" aria-label="Abrir el menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <span class="navbar-text saludo mx-auto order-md-2">Bienvenido <c:out value="${saludo}"/></span>

        <a href="${ctx}/movil/inicio" class="order-md-3 ms-md-3" title="Inicio">
            <img src="${ctx}/movil/static/img/logo-edext.svg?v=${applicationScope.versionRecursosMovil}" alt="edEXT" class="logo-edext">
        </a>

        <div class="collapse navbar-collapse order-md-1 flex-md-grow-0" id="menuMovil">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link ${seccion == 'cursos' ? 'active' : ''}" href="${ctx}/movil/cursos">Ver Cursos</a></li>
                <li class="nav-item"><a class="nav-link ${seccion == 'ediciones' ? 'active' : ''}" href="${ctx}/movil/ediciones">Ver Ediciones</a></li>
                <li class="nav-item"><a class="nav-link" href="${ctx}/movil/salir">Salir</a></li>
            </ul>
        </div>
    </div>
</nav>
